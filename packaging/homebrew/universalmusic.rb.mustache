cask "universalmusic" do
  version "{{version}}"
  sha256 "{{artifacts.macosArm64.sha256}}"

  url "{{repositoryUrl}}/releases/download/v#{version}/UniversalMusic-macos-apple-silicon.dmg",
      verified: "github.com/team-universalmusic/universalmusic/"
  name "UniversalMusic"
  desc "Open source, plugin powered music streaming client"
  homepage "https://universalmusic.cc/"

  livecheck do
    url :url
    strategy :github_latest
  end

  # Intel macs aren't supported: GraalVM native-image can't cross-compile the DMG
  depends_on arch: :arm64

  app "UniversalMusic.app"

  zap trash: [
    "~/Library/Application Support/UniversalMusic",
    "~/Library/Caches/UniversalMusic",
    "~/Library/Preferences/org.universalmusic.universalmusic.plist",
    "~/Library/Saved Application State/org.universalmusic.universalmusic.savedState",
    "~/Library/WebKit/org.universalmusic.universalmusic",
  ]
end
